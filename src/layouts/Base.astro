---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props { title: string; description?: string; image?: string; }
const {
  title,
  description = 'A running log of the hundred things I want to do, the places I have been, the books I have read, and whatever I was thinking at 2am.',
  image
} = Astro.props;

const nav = [
  { href: '/list/', label: 'the-list', icon: 'list' },
  { href: '/journal/', label: 'journal', icon: 'pen' },
  { href: '/world/', label: 'world', icon: 'globe' },
  { href: '/lab/', label: 'lab', icon: 'flask' }
];
const path = Astro.url.pathname;
const og = image
  ? (image.includes('/upload/') ? image.replace('/upload/', '/upload/f_auto,q_auto,c_fill,w_1200,h_630/') : image)
  : undefined;
const canonical = new URL(path, Astro.site ?? 'https://srinath.is-a.dev').href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="srinath.is-a.dev" />
  {og && <meta property="og:image" content={og} />}
  <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
  <meta name="theme-color" content="#0B0C0E" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title="Srinath — journal" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  <ClientRouter />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="scrollbar" aria-hidden="true"><i data-scrollbar></i></div>

  <header class="rail">
    <div class="shell rail-inner">
      <a href="/" class="brand mono" aria-label="Home">srinath<span>.is-a.dev</span></a>
      <span class="ring" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 34 34"><circle class="ring-bg" cx="17" cy="17" r="14"></circle><circle class="ring-fg" data-ring cx="17" cy="17" r="14"></circle></svg>
      </span>
      <nav class="rail-nav" aria-label="Sections">
        {nav.map((item) => (
          <a href={item.href} class:list={['nav-link', 'mono', { current: path.startsWith(item.href) }]} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="foot">
    <div class="shell foot-inner">
      <span class="mono">Built by hand. Source on GitHub.</span>
      <span class="spacer"></span>
      <a class="mono" href="https://github.com/Srinathsri22">GitHub</a>
      <a class="mono" href="#">LinkedIn</a>
      <a class="mono" href="#">Instagram</a>
      <a class="mono" href="/rss.xml">RSS</a>
    </div>
  </footer>

  <!-- Thumb-reachable navigation on phones. -->
  <nav class="dock" aria-label="Sections">
    {nav.map((item) => (
      <a href={item.href} class:list={['dock-link', { current: path.startsWith(item.href) }]} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
        {item.icon === 'list' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="9" y1="6" x2="20" y2="6"/><line x1="9" y1="12" x2="20" y2="12"/><line x1="9" y1="18" x2="20" y2="18"/><circle cx="4.5" cy="6" r="1.4"/><circle cx="4.5" cy="12" r="1.4"/><circle cx="4.5" cy="18" r="1.4"/></svg>}
        {item.icon === 'pen' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>}
        {item.icon === 'globe' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18Z"/></svg>}
        {item.icon === 'flask' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-5.5 9A2 2 0 0 0 6.2 21h11.6a2 2 0 0 0 1.7-3L14 9V3"/></svg>}
        <span>{item.label.replace('the-', '')}</span>
      </a>
    ))}
  </nav>

  <style>
    .rail { border-bottom: 1px solid var(--line); background: rgba(11,12,14,0.86); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 5; padding-top: env(safe-area-inset-top, 0px); }
    .rail-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
    .brand { font-size: 13px; color: var(--ink); padding-block: 15px; }
    .brand span { color: var(--ink-faint); }
    .brand:hover { text-decoration: none; color: var(--amber); }
    .ring { display: grid; place-items: center; width: 34px; height: 34px; margin-left: 14px; }
    .ring svg { transform: rotate(-90deg); }
    .ring circle { fill: none; stroke-width: 3; }
    .ring-bg { stroke: var(--line-strong); }
    .ring-fg { stroke: var(--amber); stroke-linecap: round; stroke-dasharray: 88; stroke-dashoffset: 88; }
    .rail-nav { display: flex; flex-wrap: wrap; margin-left: auto; }
    .nav-link { font-size: 13px; color: var(--ink-dim); padding: 14px 12px; min-height: 44px; display: flex; align-items: center; }
    .nav-link:hover { color: var(--ink); text-decoration: none; }
    .nav-link.current { color: var(--amber); }

    .foot { border-top: 1px solid var(--line); margin-top: 72px; }
    .foot-inner { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; padding-block: 26px; font-size: 12px; color: var(--ink-faint); }
    .foot-inner .spacer { flex: 1 1 0; }
    .foot-inner a { font-size: 12px; color: var(--ink-dim); }

    .dock { display: none; }
    @media (max-width: 720px) {
      .rail-nav { display: none; }
      .dock {
        display: grid; grid-template-columns: repeat(4, 1fr);
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 8;
        background: rgba(11,12,14,0.94); backdrop-filter: blur(14px);
        border-top: 1px solid var(--line);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      .dock-link { display: grid; justify-items: center; gap: 4px; padding: 9px 4px 8px; min-height: 56px; color: var(--ink-faint); font-size: 10px; letter-spacing: 0.06em; font-family: 'JetBrains Mono', monospace; }
      .dock-link:hover { text-decoration: none; }
      .dock-link svg { width: 21px; height: 21px; }
      .dock-link.current { color: var(--amber); }
      .foot { margin-bottom: 72px; }
    }
  </style>
  <script>
    // All page motion lives here: reveals, count-ups, progress bars, parallax.
    // Re-runs after every client-side navigation.
    function motion() {
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const tick = (el: Element, to: number, dur = 900) => {
        if (calm || !to) { el.textContent = String(to); return; }
        const t0 = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - t0) / dur);
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      // Hero counter fires on load rather than on scroll.
      document.querySelectorAll<HTMLElement>('[data-count-to]').forEach((el) => {
        setTimeout(() => tick(el, Number(el.dataset.countTo || 0), 1100), 740);
      });

      // Reveal on enter, staggered by position among its siblings. Progress
      // bars and in-view numbers animate a beat after their row lands.
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          const sibs = Array.from(el.parentElement?.children ?? []).filter((n) => n.classList.contains('r'));
          const i = Math.max(0, sibs.indexOf(el));
          el.style.transitionDelay = `${i * 70}ms`;
          el.classList.add('in');
          el.querySelectorAll<HTMLElement>('[data-bar]').forEach((b) => {
            setTimeout(() => { b.style.width = `${b.dataset.bar}%`; }, 260 + i * 70);
          });
          el.querySelectorAll<HTMLElement>('[data-num]').forEach((n) => tick(n, Number(n.dataset.num || 0), 800));
          io.unobserve(el);
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
      document.querySelectorAll('.r').forEach((el) => io.observe(el));

      // Stat numbers outside a reveal block.
      const sio = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          tick(el, Number(el.dataset.stat || 0), 900);
          sio.unobserve(el);
        });
      });
      document.querySelectorAll('[data-stat]').forEach((el) => sio.observe(el));

      // Scroll position drives the top line, the ring in the rail, and the
      // sideways drift of the photo strip.
      const sb = document.querySelector<HTMLElement>('[data-scrollbar]');
      const ring = document.querySelector<HTMLElement>('[data-ring]');
      const film = document.querySelector<HTMLElement>('[data-parallax]');
      let queued = false;
      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? window.scrollY / max : 0;
          if (sb) sb.style.width = `${p * 100}%`;
          if (ring) ring.style.strokeDashoffset = String(88 - 88 * p);
          if (film && !calm) film.style.transform = `translateX(${-window.scrollY * 0.12}px)`;
          queued = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    motion();
    document.addEventListener('astro:page-load', motion);
  </script>
</body>
</html>
