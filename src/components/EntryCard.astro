---
import Photo from './Photo.astro';
interface Props { href: string; title: string; kind: string; date: Date; summary?: string; cover?: string; count?: number; class?: string; }
const { href, title, kind, date, summary, cover, count = 0, class: cls } = Astro.props;
const kindLabel = { book: 'Book note', memory: 'Memory', thought: 'Thought', trip: 'Trip' }[kind] ?? kind;
const stamp = date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<a class:list={['card', cls]} href={href}>
  {cover && <span class="shot"><Photo src={cover} alt="" width={560} ratio="16 / 10" />
    {count > 0 && <span class="badge mono">+{count}</span>}
  </span>}
  <span class="meta mono"><span class="kind">{kindLabel}</span><span class="date">{stamp}</span></span>
  <span class="title">{title}</span>
  {summary && <span class="summary">{summary}</span>}
</a>
<style>
  .card { display: flex; flex-direction: column; gap: 10px; background: var(--surface); border: 1px solid var(--line); padding: 18px; color: var(--ink); height: 100%; transition: border-color 160ms ease, transform 160ms ease; }
  .card:hover, .card:focus-visible { border-color: var(--line-strong); text-decoration: none; transform: translateY(-2px); }
  .card:hover .title { color: var(--amber); }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
  .shot { position: relative; display: block; margin: -18px -18px 4px; }
  :global(.shot img) { border: none; border-bottom: 1px solid var(--line); }
  .badge { position: absolute; right: 10px; bottom: 10px; background: rgba(11,12,14,0.86); border: 1px solid var(--line-strong); padding: 3px 7px; font-size: 10px; color: var(--ink-dim); }
  .meta { display: flex; justify-content: space-between; gap: 12px; font-size: 10px; letter-spacing: 0.08em; }
  .kind { color: var(--amber); }
  .date { color: var(--ink-faint); }
  .title { font-size: 19px; font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; transition: color 140ms ease; }
  .summary { font-size: 14px; color: var(--ink-dim); line-height: 1.55; }
</style>
