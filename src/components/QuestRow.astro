---
interface Props { number: number; title: string; status: 'cleared' | 'active' | 'someday'; progress?: number; note?: string; slug?: string; photos?: string[]; reveal?: boolean; }
const { number, title, status, progress = 0, note, slug, photos = [], reveal = false } = Astro.props;
const label = { cleared: 'cleared', active: 'in progress', someday: 'someday' }[status];
const pad = String(number).padStart(3, '0');
const Tag = slug ? 'a' : 'div';
const href = slug ? `/list/${slug}/` : undefined;
---
<li class:list={['row', status, { r: reveal }]}>
  <Tag href={href} class="hit">
    <span class="num mono">{pad}</span>
    <span class="body">
      <span class="title">{title}</span>
      {note && <span class="note mono">{note}</span>}
      {status === 'active' && progress > 0 && (
        <span class="track"><span class="fill" data-bar={progress}></span></span>
      )}
    </span>
    <span class="status mono">
      {photos.length > 0 && (
        <span class="shots" aria-label={`${photos.length} photos`}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="12" cy="12" r="3.2"/></svg>{photos.length}
        </span>
      )}
      {status === 'cleared' && (
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
      )}
      {label}
    </span>
  </Tag>
</li>
<style>
  .row { list-style: none; border-bottom: 1px solid var(--line); }
  .hit { display: grid; grid-template-columns: 50px 1fr auto; gap: 8px 18px; align-items: baseline; padding: 18px 0; color: var(--ink); }
  a.hit:hover { text-decoration: none; }
  a.hit:hover .title { color: var(--amber); }
  .num { font-size: 12px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .title { display: block; font-size: 18px; line-height: 1.4; transition: color 140ms ease; }
  .note { display: block; font-size: 11px; color: var(--ink-faint); margin-top: 6px; }
  .status { display: inline-flex; align-items: center; gap: 8px; font-size: 10px; letter-spacing: 0.08em; color: var(--ink-dim); white-space: nowrap; }
  .shots { display: inline-flex; align-items: center; gap: 4px; color: var(--ink-faint); }
  .track { display: block; height: 3px; background: var(--line-strong); margin-top: 12px; max-width: 280px; overflow: hidden; }
  .fill { display: block; height: 100%; width: 0; background: var(--amber); transition: width 1s cubic-bezier(.2,.8,.2,1); }
  @media (prefers-reduced-motion: reduce) { .fill { transition: none; } }
  .cleared .title { color: var(--ink-faint); text-decoration: line-through; text-decoration-color: var(--amber-dim); }
  .cleared .num, .cleared .status { color: var(--green); }
  .someday .title { color: var(--ink-dim); }
  @media (max-width: 620px) {
    .hit { grid-template-columns: 40px 1fr; padding: 16px 0; }
    .status { grid-column: 2; margin-top: 8px; }
    .title { font-size: 17px; }
  }
</style>
