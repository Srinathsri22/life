---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import QuestRow from '../components/QuestRow.astro';
import EntryCard from '../components/EntryCard.astro';
import Photo from '../components/Photo.astro';

const quests = (await getCollection('quests')).sort((a, b) => a.data.number - b.data.number);
const cleared = quests.filter((q) => q.data.status === 'cleared').length;
const featured = [
  ...quests.filter((q) => q.data.status === 'active'),
  ...quests.filter((q) => q.data.status === 'someday')
].slice(0, 4);

const journal = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = journal.slice(0, 3);

const places = await getCollection('places');
const visited = places.filter((p) => p.data.visited);
const countries = new Set(visited.map((p) => p.data.country));
const books = journal.filter((e) => e.data.kind === 'book').length;

// Most recent photos from anywhere, for the strip under the hero.
const recentPhotos = journal
  .flatMap((e) => [e.data.cover, ...e.data.photos].filter(Boolean) as string[])
  .slice(0, 6);

const latest = journal[0];
const heroImage = latest?.data.cover;
---
<Base title="Srinath — one hundred things" image={heroImage}>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow mono">Personal log</p>
      <h1>
        <span class="line"><i>One hundred</i></span>
        <span class="line"><i>things to do</i></span>
        <span class="line"><i>before I'm done.</i></span>
      </h1>
      <p class="lede">
        I write software for a living. This is the other half — the list I'm working
        through in the open, the places I've been, the books that stuck, and the
        thoughts that would otherwise die in my notes app.
      </p>

      <div class="counter">
        <div class="count">
          <span class="big mono" data-count-to={cleared}>0</span>
          <span class="of mono">of 100 cleared</span>
        </div>
        <div class="track" role="img" aria-label={`${cleared} of 100 cleared`}>
          <div class="fill" style={`--target:${cleared}%`}></div>
        </div>
        <dl class="stats mono">
          <div><dt>Places</dt><dd data-stat={visited.length}>0</dd></div>
          <div><dt>Countries</dt><dd data-stat={countries.size}>0</dd></div>
          <div><dt>Books</dt><dd data-stat={books}>0</dd></div>
          <div><dt>Entries</dt><dd data-stat={journal.length}>0</dd></div>
        </dl>
      </div>
    </div>

    {recentPhotos.length > 0 && (
      <div class="film" data-parallax aria-label="Recent photos">
        {recentPhotos.map((src, i) => (
          <a class="frame" href={`/journal/${journal[0].id}/`} tabindex={i === 0 ? 0 : -1} aria-hidden={i === 0 ? undefined : 'true'}>
            <Photo src={src} alt="" width={420} ratio="3 / 4" />
          </a>
        ))}
      </div>
    )}
  </section>

  <div class="marquee" aria-hidden="true">
    <ul><li>Guitar</li><li>Japan</li><li>First bike</li><li>Books</li><li>Night rides</li><li>Stray thoughts</li></ul>
    <ul><li>Guitar</li><li>Japan</li><li>First bike</li><li>Books</li><li>Night rides</li><li>Stray thoughts</li></ul>
  </div>

  <section class="section">
    <div class="shell">
      <div class="section-head r">
        <h2>The list</h2>
        <span class="spacer"></span>
        <a class="mono" href="/list/">All 100</a>
      </div>
      {featured.length === 0
        ? <p class="empty mono">No quests yet. Add the first one at /admin/.</p>
        : <ul class="rows">{featured.map((q) => <QuestRow {...q.data} slug={q.id} reveal />)}</ul>}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head r">
        <h2>Journal</h2>
        <span class="spacer"></span>
        <a class="mono" href="/journal/">Everything</a>
      </div>
      {entries.length === 0
        ? <p class="empty mono">Nothing written yet.</p>
        : <div class="grid-3">{entries.map((e) => (
            <EntryCard class="r" href={`/journal/${e.id}/`} title={e.data.title} kind={e.data.kind} date={e.data.date} summary={e.data.summary} cover={e.data.cover} count={e.data.photos.length} />
          ))}</div>}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head r">
        <h2>Been there</h2>
        <span class="spacer"></span>
        <a class="mono" href="/world/">The map</a>
      </div>
      {visited.length === 0
        ? <p class="empty mono">No places pinned yet.</p>
        : <div class="grid-4">{visited.slice(0, 4).map((p) => (
            <a class="place r" href="/world/">
              {p.data.cover
                ? <Photo src={p.data.cover} alt={p.data.name} width={420} ratio="3 / 4" />
                : <span class="placeholder" aria-hidden="true"></span>}
              <span class="place-name mono">{p.data.name}</span>
            </a>
          ))}</div>}
    </div>
  </section>

  <style>
    .hero { padding-block: clamp(48px, 9vw, 120px) 0; }
    .eyebrow { font-size: 11px; letter-spacing: 0.2em; color: var(--amber); margin-bottom: 22px; opacity: 0; animation: rise .7s cubic-bezier(.2,.8,.2,1) .1s both; }
    h1 { font-size: clamp(34px, 8.5vw, 76px); letter-spacing: -0.035em; }
    .lede { max-width: 54ch; margin-top: 24px; font-size: clamp(16px, 2vw, 19px); color: var(--ink-dim); opacity: 0; animation: rise .8s cubic-bezier(.2,.8,.2,1) .62s both; }
    .counter { margin-top: clamp(32px, 6vw, 56px); display: grid; gap: 16px; max-width: 620px; opacity: 0; animation: rise .8s cubic-bezier(.2,.8,.2,1) .74s both; }
    .count { display: flex; align-items: baseline; gap: 12px; }
    .big { font-size: clamp(44px, 12vw, 72px); font-weight: 500; color: var(--amber); line-height: 1; font-variant-numeric: tabular-nums; }
    .of { font-size: 11px; letter-spacing: 0.14em; color: var(--ink-dim); }
    .track { height: 4px; background: var(--line-strong); overflow: hidden; }
    .fill { height: 100%; width: var(--target); background: var(--amber); animation: grow 1300ms cubic-bezier(.2,.8,.2,1) 780ms both; }
    @keyframes grow { from { width: 0; } }
    @media (prefers-reduced-motion: reduce) { .fill { animation: none; } }
    .stats { display: flex; flex-wrap: wrap; gap: 10px 24px; margin: 2px 0 0; }
    .stats div { display: flex; align-items: baseline; gap: 7px; }
    .stats dt { font-size: 10px; letter-spacing: 0.1em; color: var(--ink-faint); }
    .stats dd { margin: 0; font-size: 15px; }

    .film {
      display: grid; grid-auto-flow: column; grid-auto-columns: 42%; will-change: transform;
      gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory;
      padding: clamp(32px, 5vw, 56px) var(--gutter) 0; margin: 0 auto;
      max-width: calc(var(--shell) + var(--gutter) * 2); scrollbar-width: none;
    }
    .film::-webkit-scrollbar { display: none; }
    .frame { scroll-snap-align: start; }
    @media (min-width: 760px) { .film { grid-auto-columns: 20%; } }

    .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; }
    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
    .place { display: block; position: relative; color: var(--ink); }
    .place:hover { text-decoration: none; }
    .placeholder { display: block; aspect-ratio: 3 / 4; background: var(--surface); border: 1px solid var(--line); }
    .place-name { position: absolute; left: 0; right: 0; bottom: 0; background: rgba(11,12,14,0.92); border-top: 1px solid var(--line); padding: 9px 11px; font-size: 10px; letter-spacing: 0.08em; }
    .empty { font-size: 13px; color: var(--ink-faint); }
  </style>

</Base>
