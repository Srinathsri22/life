---
// A real route, so /admin/ resolves in dev and in production alike.
// The config lives at /admin/config.yml in public/ and is fetched by Sveltia.
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title>Content admin</title>
  <link href="/admin/config.yml" type="application/yaml" rel="cms-config-url" />
</head>
<body>
  <script src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js" type="module" is:inline></script>
</body>
</html>
